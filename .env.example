# Agentic Service Desk — 설정 예시
#
# 실제 값은 `.env` 에 넣는다. `.env` 는 git 이 추적하지 않는다.

# --- 도입 단계 (D49) ---------------------------------------------------
# S0~S5. 기본 S0 은 대외 노출이 없는 구간이다.
ASD_STAGE=S0

# --- 모 시스템 연동 (ADR-008) ------------------------------------------
# 개발 중에는 mock 을 쓴다. 실제 API 가 생기면 http 로 바꾸고 주소를 채운다.
ASD_PARENT_ADAPTER=mock
# ASD_PARENT_API_BASE_URL=https://parent.internal/api
# ASD_PARENT_REPO_URL=git@internal:team/parent-system.git

# --- LLM (ADR-005 · NFR-1) ---------------------------------------------
#
# 운영 환경 — 로컬 GPU 서버. 원격 허용 플래그가 필요 없다.
#
#   ASD_LLM_BASE_URL=http://gpu-box.local:8000/v1
#   ASD_LLM_MODEL=<로컬 모델>
#   ASD_EMBEDDING_PROVIDER=openai_compatible   (로컬 런타임 대부분이 이 형식)
#
# 개발 환경 — 실제 데이터가 없을 때만 원격 제공자를 쓸 수 있다.
# 아래 셋이 **모두** 참이어야 열린다 (ADR-005 §개발 환경).
#   1. ASD_LLM_ALLOW_REMOTE=true
#   2. ASD_PARENT_ADAPTER=mock        (실제 QnA 없음)
#   3. ASD_PARENT_REPO_URL 이 비어 있음 (실제 코드 없음)
#
ASD_LLM_ALLOW_REMOTE=true
ASD_LLM_BASE_URL=https://api.minimax.io/v1
ASD_LLM_MODEL=MiniMax-M3
ASD_LLM_API_KEY=

# MiniMax 임베딩은 **OpenAI 호환이 아니다** (2026-08-28 조사).
#   요청  texts + type(db|query)   ← OpenAI 는 input
#   응답  최상위 vectors            ← OpenAI 는 data[].embedding
#   오류  base_resp.status_code    ← HTTP 상태가 아니다
ASD_EMBEDDING_PROVIDER=minimax
ASD_LLM_EMBEDDING_MODEL=embo-01
# ASD_EMBEDDING_BASE_URL=   # 비우면 ASD_LLM_BASE_URL 을 쓴다

# 지역: 글로벌은 api.minimax.io, 중국은 api.minimaxi.com

# --- pi 하네스 (ADR-009) -----------------------------------------------
# 지식 구축 에이전트는 pi 가 돌린다. pi 의 제공자 설정은 **이 파일에서 생성**한다.
#
#   uv run asd sync-harness            # ~/.pi/agent/models.json 생성
#   uv run asd sync-harness --dry-run  # 내용만 확인
#
# 배포 시 바꾸는 것은 이 파일 하나다 — 생성기를 다시 돌리면 애플리케이션과 pi 가
# 함께 움직인다. pi 는 우리 NFR-1 정책을 지나지 않으므로 **생성 시점이 검문소**다.

# --- 보존 (PO-4) --------------------------------------------------------
# 비워 두면 무제한. 사내 정책이 생기면 일수를 넣는다.
# ASD_RETENTION_DAYS=

# --- 알림 (ADR-007) -----------------------------------------------------
# 위험 대기열·국면 역행 알림. 비우면 대시보드 배너로만 알린다.
# ASD_ALERT_WEBHOOK_URL=
