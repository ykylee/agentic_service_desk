# Agentic Service Desk — 설정 예시
#
# 실제 값은 `.env` 에 넣는다. `.env` 는 git 이 추적하지 않는다.

# --- 도입 단계 (D49) ---------------------------------------------------
# S0~S5. 기본 S0 은 대외 노출이 없는 구간이다.
ASD_STAGE=S0

# --- 모 시스템 연동 (ADR-008) ------------------------------------------
# 개발 중에는 mock 을 쓴다. 실제 API 가 생기면 http 로 바꾸고 주소를 채운다.
ASD_PARENT_ADAPTER=mock
# ASD_PARENT_API_BASE_URL=https://parent.internal/api
# ASD_PARENT_REPO_URL=git@internal:team/parent-system.git

# --- LLM (ADR-005 · NFR-1) ---------------------------------------------
#
# 운영 환경 — 로컬 GPU 서버. 원격 허용 플래그가 필요 없다.
#
#   ASD_LLM_BASE_URL=http://gpu-box.local:8000/v1
#   ASD_LLM_MODEL=<로컬 모델>
#
# 개발 환경 — 실제 데이터가 없을 때만 원격 제공자를 쓸 수 있다.
# 아래 셋이 **모두** 참이어야 열린다 (ADR-005 §개발 환경).
#   1. ASD_LLM_ALLOW_REMOTE=true
#   2. ASD_PARENT_ADAPTER=mock        (실제 QnA 없음)
#   3. ASD_PARENT_REPO_URL 이 비어 있음 (실제 코드 없음)
#
ASD_LLM_ALLOW_REMOTE=true
ASD_LLM_BASE_URL=https://api.minimax.io/v1
ASD_LLM_MODEL=MiniMax-Text-01
ASD_LLM_API_KEY=

# --- 보존 (PO-4) --------------------------------------------------------
# 비워 두면 무제한. 사내 정책이 생기면 일수를 넣는다.
# ASD_RETENTION_DAYS=

# --- 알림 (ADR-007) -----------------------------------------------------
# 위험 대기열·국면 역행 알림. 비우면 대시보드 배너로만 알린다.
# ASD_ALERT_WEBHOOK_URL=
